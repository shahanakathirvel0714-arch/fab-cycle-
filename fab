 if(s==='repair'){g.status='repaired';g.last='Repaired · '+t;c.repaired++;c.kg+=.6;S.notes.unshift({t:'A repair worth celebrating',d:`${g.id} was repaired instead of replaced.`,w:t,u:1})}
