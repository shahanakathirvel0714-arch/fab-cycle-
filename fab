<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const MEM={};const LS=(k,v)=>{if(v===undefined){try{const r=localStorage.getItem(k);if(r!==null)return JSON.parse(r)}catch(e){}return k in MEM?MEM[k]:null}MEM[k]=v;try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}};
const today=()=>new Date().toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const IC={home:'<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14zM5 19c3-4 6-7 9-9"/>',scan:'<path d="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M4 12h16"/>',garments:'<path d="M9 4L3 7l2 4 2-1v10h10V10l2 1 2-4-6-3a3 3 0 01-6 0z"/>',library:'<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 115 0c0 1.5-2.5 2-2.5 3.5M12 17v.5"/>',impact:'<path d="M12 21v-9M12 12c0-4 3-6 6-6 0 4-2 6-6 6zM12 15c0-3-2-5-5-5 0 3 2 5 5 5z"/>'};
const NAV=[['home','Home','Home'],['scan','Scan a tag','Scan'],['garments','My garments','Wardrobe'],['library','Care library','Learn'],['impact','Our impact','Impact']];
const LB={active:'Active',repaired:'Repaired',collection:'Collection requested'};
const COL={tee:'#a6ad82',shirt:'#d8c9ad',jeans:'#34507a',kurta:'#b9694d',scarf:'#b35f45'};
const SH={tee:'M35 12l-22 10 6 14 8-4v34h46V32l8 4 6-14-22-10c-3 6-8 8-14 8s-11-2-14-8z',shirt:'M35 12l-22 10 6 14 8-4v34h46V32l8 4 6-14-22-10-8 14-8-14z',jeans:'M30 6h40l4 68H56L50 28l-6 46H26z',kurta:'M35 6l-22 10 6 14 8-4v46h46V26l8 4 6-14-22-10c-3 6-8 8-14 8s-11-2-14-8z',scarf:'M20 14c14 10 30-8 46 2s14 20 14 40l-18 4c0-14 0-22-12-26s-22 6-30 0z'};
