const seed=()=>({garments:[
 {id:'RT-00125',name:'Cotton T Shirt',meta:'GreenWear · 100% organic cotton',type:'tee',status:'active',last:'Added To Fabcycle'},
 {id:'RT-00126',name:'Linen Button Down',meta:'Common Thread · 100% linen',type:'shirt',status:'repaired',last:'Button Replaced · 18 Sep 2026'},
 {id:'RT-00127',name:'Straight Leg Jeans',meta:'Reform Denim · 98% cotton, 2% elastane',type:'jeans',status:'collection',last:'Pickup Requested · 5 Oct 2026'},
 {id:'RT-00128',name:'Cotton Kurta',meta:'Weave Stories · 100% handloom cotton',type:'kurta',status:'active',last:'Added To Fabcycle'},
 {id:'RT-00129',name:'Wool Blend Scarf',meta:'North Loop · 70% wool, 30% recycled polyester',type:'scarf',status:'active',last:'Added To Fabcycle'}],
 c:{saved:25,repaired:18,recycled:7,collected:12,kg:15.4},
 notes:[{t:'Collector assigned',d:'Arun Kumar is scheduled to collect RT-00127 on 10 October.',w:'5 Oct 2026',u:1},{t:'Collection request received',d:'Your request FC-2026-00125 is now being processed.',w:'5 Oct 2026',u:1},{t:'A repair worth celebrating',d:'RT-00126 was repaired instead of replaced.',w:'5 Oct 2026'},{t:'New repair tutorial',d:'Learn a simple backstitch in our 15-minute seam repair guide.',w:'5 Oct 2026'}],
 p:{phone:'',city:'',addr:'',pin:''},team:[]});
const G=[
['Add a Visible Mending Patch','Repair','Turn a worn spot into a durable detail with a scrap of contrasting fabric.','Medium',35,['Cut a patch of sturdy fabric 2 cm larger than the worn spot.','Pin it behind the worn area and fold the edges under.','Stitch around the edge with a running stitch in contrasting thread.','Press flat and trim loose threads.']],
['Close an Open Seam','Repair','Use a neat backstitch to close a seam without a sewing machine.','Easy',15,['Turn the garment inside out and align the open edges.','Pin along the opening.','Sew small backstitches along the original seam line.','Knot the thread and trim.']],
['Fix a Stuck Zipper','Repair','Free a caught zipper and replace a worn slider with simple tools.','Medium',25,['Close the zipper fully and free any caught fabric.','Rub a graphite pencil or soap along the teeth.','Gently wiggle the slider back and forth.','If the slider is worn, swap in a new one with pliers.']],
['Hand-sew a Trouser Hem','Repair','Make a discreet hem that sits evenly and moves comfortably.','Easy',30,['Try the trousers on and mark the new length with pins.','Fold the hem up twice and press.','Sew with a hidden blind stitch.','Press and check the length.']],
['Mend a Small Hole','Repair','Reinforce a small tear from the inside so it stays strong after washing.','Medium',20,['Turn the garment inside out.','Place a small patch over the hole.','Stitch back and forth across the hole to reinforce it.','Wash gently to check it holds.']],
['Replace a Loose Button','Repair','A secure, tidy four-hole button repair using a needle and matching thread.','Easy',8,['Thread a needle with matching thread and knot the end.','Position the button and pass the needle through the holes.','Stitch through each pair of holes 6 to 8 times.','Wrap thread under the button, then knot.']],
['Fabric Scraps into Scrunchies','Upcycling','A quick beginner-friendly project for small cotton offcuts.','Easy',20,['Cut a strip of fabric about 10 × 40 cm.','Fold lengthwise and sew along the long edge.','Thread elastic through and tie it.','Sew the ends closed.']],
['Make a Pouch from Old Jeans','Upcycling','Use a sturdy denim leg to sew a lined zip pouch for daily essentials.','Medium',45,['Cut a section from an old jeans leg.','Sew one end closed and attach a zip at the top.','Add a lining fabric inside.','Turn out and press.']],
['Old T-shirt to Everyday Tote','Upcycling','Give a soft, worn T-shirt a second life as a useful shopping bag.','Easy',25,['Cut off the sleeves and neckline.','Sew the bottom hem closed.','Reinforce the straps with a second line of stitching.','Turn out and use.']],
['Start a Patchwork Panel','Upcycling','Join fabric scraps into a strong panel for future bags or homewares.','Advanced',60,['Sort scraps by weight and colour.','Cut equal squares.','Sew squares into rows, then join the rows.','Press seams flat and back the panel.']]];
