function gForm(id){const g=id?S.garments.find(x=>x.id===id):null;window._eimg=g?g.img:null;window._eid=id||null;
 open(`<div class="eb">${g?'Edit garment':'New garment'}</div><h2>${g?'Edit details':'Add a garment'}</h2><div id="epv">${window._eimg?`<img class="pv" src="${window._eimg}" alt="">`:''}</div><label for="gn">Garment name</label><input class="fld" id="gn" value="${esc(g?g.name:'')}" placeholder="e.g. Blue denim jacket"><label for="gm">Brand and material</label><input class="fld" id="gm" value="${esc(g?g.meta:'')}" placeholder="e.g. Reform Denim · 100% cotton"><label for="gy">Type</label><select class="fld" id="gy">${[['tee','T-shirt'],['shirt','Shirt'],['jeans','Jeans or trousers'],['kurta','Kurta'],['scarf','Scarf']].map(o=>`<option value="${o[0]}" ${g&&g.type===o[0]?'selected':''}>${o[1]}</option>`).join('')}</select><label for="gs">Status</label><select class="fld" id="gs">${Object.keys(LB).map(k=>`<option value="${k}" ${g&&g.status===k?'selected':''}>${LB[k]}</option>`).join('')}</select><label for="gp">Photo (optional)</label><input type="file" id="gp" accept="image/*"><p class="err" id="gerr"></p><div class="row"><button class="btn dark" data-act="saveG">${g?'Save changes':'Add garment'}</button>${g?`<button class="btn line" data-act="askdel" data-id="${id}" style="color:#b4372b">Delete</button>`:''}</div>`)}
function saveG(){const n=$('#gn').value.trim();if(!n){$('#gerr').textContent='Enter a name for the garment.';return}
 const o={name:n,meta:$('#gm').value.trim()||'Added by you',type:$('#gy').value,status:$('#gs').value};
 if(window._eid){const g=S.garments.find(x=>x.id===window._eid);Object.assign(g,o);g.img=window._eimg||undefined;g.last='Edited · '+today();sv();close();go(view);toast('Garment updated')}
 else{const num=Math.max(124,...S.garments.map(x=>+x.id.slice(3)))+1;S.garments.unshift({id:'RT-'+String(num).padStart(5,'0'),...o,last:'Added To Fabcycle',img:window._eimg||undefined});S.c.saved++;S.c.kg+=.4;sv();close();go('garments');toast('Garment added')}}
function addG(){const n=$('#nn').value.trim();if(!n){$('#nerr').textContent='Enter a name for the garment.';return}
 const num=125+S.garments.length;S.garments.unshift({id:'RT-'+String(num).padStart(5,'0'),name:n,meta:$('#nm').value.trim()||'Added from photo',type:'tee',status:'active',last:'Added To Fabcycle',img:window._img});
 S.c.saved++;S.c.kg+=.4;sv();close();go('garments');toast('Garment added')}
document.addEventListener('click',e=>{
 if(e.target.id==='ov')return close();
 const b=e.target.closest('[data-act]');if(!b)return;const a=b.dataset.act;if(a==='demo')e.preventDefault();
 if(a==='go'){close();$('#mt')?.remove();go(b.dataset.v)}
 else if(a==='cam')$('#cam').click();else if(a==='gal')$('#gal').click();
 else if(a==='open')detail(b.dataset.id);else if(a==='guide')guide(+b.dataset.i);
 else if(a==='step')step(b.dataset.s,b.dataset.id);else if(a==='close')close();
 else if(a==='find')find($('#code').value);else if(a==='demo')find(b.dataset.c);
 else if(a==='addG')addG();
 else if(a==='pickup')pForm();else if(a==='savePk')savePk();else if(a==='cancelPk')cancelPk(b.dataset.id);
 else if(a==='newG')gForm();else if(a==='edit')gForm(b.dataset.id);else if(a==='saveG')saveG();
 else if(a==='askdel')open(`<h2>Delete this garment?</h2><p style="color:var(--mut)">It will be removed from your wardrobe. This can’t be undone.</p><div class="row"><button class="btn dark" data-act="deleteG" data-id="${b.dataset.id}" style="background:#b4372b">Delete</button><button class="btn line" data-act="close">Cancel</button></div>`);
 else if(a==='deleteG'){S.garments=S.garments.filter(x=>x.id!==b.dataset.id);S.c.saved=Math.max(0,S.c.saved-1);sv();close();go(view);toast('Garment deleted')}
 else if(a==='read'){S.notes[+b.dataset.i].u=0;sv();go('profile')}
 else if(a==='saveP'){NAME=$('#pn').value.trim()||NAME;S.p={phone:$('#pp').value,city:$('#pc').value,addr:$('#pa').value,pin:$('#pz').value};const U=LS('fc2_users')||{};if(U[E]){U[E].name=NAME;LS('fc2_users',U)}sv();shell();go('profile');toast('Profile saved')}
 else if(a==='menu')open(`<h2>Menu</h2><div class="row" style="flex-direction:column;align-items:stretch"><button class="btn line" data-act="go" data-v="profile">My profile</button><button class="btn line" data-act="team">Team workspace</button><button class="btn dark" data-act="out">Sign out</button></div>`);
 else if(a==='team'){open(`<h2>Team workspace</h2><p style="color:var(--mut)">Invite someone to care for garments with you.</p><div id="tl">${S.team.map(m=>`<p>👤 ${esc(m)}</p>`).join('')||'<p>Just you for now.</p>'}</div><input class="fld" id="inv" placeholder="teammate@email.com"><div class="row"><button class="btn dark" data-act="invite">Send invite</button></div>`)}
 else if(a==='invite'){const v=$('#inv').value.trim();if(/^\S+@\S+\.\S+$/.test(v)){S.team.push(v);sv();close();toast('Invite sent to '+v)}else toast('Enter a valid email')}
 else if(a==='out'){LS('fc2_sess',null);try{localStorage.removeItem('fc2_sess')}catch(x){}close();['side','mtop','main','bnav'].forEach(i=>$('#'+i).hidden=true);$('#ath').hidden=false;$('#aP').value='';setM('login')}
});
document.addEventListener('input',e=>{if(e.target.id==='gq')fg();if(['lq','lc','ld'].includes(e.target.id))fl()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if(e.key==='Enter'&&e.target.id==='code')find(e.target.value);if(e.key==='Enter'&&['aE','aP','aN'].includes(e.target.id))$('#aG').click()});
function start(email,name){E=email;NAME=name;S=LS('fc2:'+E)||seed();sv();shell();['side','mtop','main','bnav'].forEach(i=>$('#'+i).hidden=false);$('#ath').hidden=true;go('home')}
// Auth (demo: stored in this browser only)
let mode='login';const hash=async p=>{try{return [...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(p)))].map(x=>x.toString(16).padStart(2,'0')).join('')}catch(e){let h=5381;for(const c of p)h=(h*33)^c.charCodeAt(0);return 'x'+(h>>>0)}};
function setM(m){mode=m;const s=m==='signup';$('#nr').hidden=!s;$('#aT').textContent=s?'Create your account':'Welcome back';$('#aS').textContent=s?'Start giving your clothes a longer life.':'Log in to see your care closet.';$('#aG').textContent=s?'Sign up':'Log in';$('#aW').textContent=s?'Have an account? Log in':'New here? Create an account';$('#aR').textContent=''}
$('#aW').onclick=()=>setM(mode==='login'?'signup':'login');
$('#aG').onclick=async()=>{try{await doAuth()}catch(x){$('#aR').textContent='Something went wrong. Please try again.'}if($('#aR').textContent)$('#aR').scrollIntoView({block:'center'})};
const doAuth=async()=>{const em=$('#aE').value.trim().toLowerCase(),pw=$('#aP').value,nm=$('#aN').value.trim(),er=$('#aR'),U=LS('fc2_users')||{};
 if(!/^\S+@\S+\.\S+$/.test(em))return er.textContent='Enter a valid email address.';
 if(pw.length<6)return er.textContent='Password must be at least 6 characters.';
 const h=await hash(pw);
 if(mode==='signup'){if(!nm)return er.textContent='Enter your name.';if(U[em])return er.textContent='This email already has an account. Log in instead.';U[em]={name:nm,h};LS('fc2_users',U)}
 else if(!U[em]||U[em].h!==h)return er.textContent='Email or password is incorrect.';
 LS('fc2_sess',em);start(em,U[em].name)};
{const se=LS('fc2_sess'),U=LS('fc2_users')||{};if(se&&U[se])start(se,U[se].name)}
</script>
</body>
</html>
