<title>Fabcycle</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f7f5f0;--card:#fdfcf9;--ink:#1f3a2e;--mut:#667269;--line:#e6e2d8;--forest:#2e5042;--side:#24402f;--sand:#e2c699;--clay:#b98d63;--sage:#8a9a85;--inp:#f3f0e8;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#111a15;--card:#1a2620;--ink:#ece7dc;--mut:#a2b0a7;--line:#2b3a32;--inp:#22302a;--forest:#2a4a3b}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#111a15;--card:#1a2620;--ink:#ece7dc;--mut:#a2b0a7;--line:#2b3a32;--inp:#22302a;--forest:#2a4a3b}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "DM Sans",system-ui,sans-serif;-webkit-tap-highlight-color:transparent}
h1,h2,h3{font-family:"Fraunces",Georgia,serif;font-weight:500;margin:0;line-height:1.08;letter-spacing:-.02em}
button{font:inherit;cursor:pointer;border:0;color:inherit;background:none}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--sand);outline-offset:2px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:15px 24px;border-radius:99px;font-weight:700}
.sand{background:var(--sand);color:#2a3a30}.dark{background:var(--forest);color:#f7f5f0}
.out{border:1.5px solid rgba(247,245,240,.35);color:#f7f5f0}.line{border:1.5px solid var(--line)}
.side{position:fixed;inset:0 auto 0 0;width:310px;background:var(--side);color:#e9efe9;display:none;flex-direction:column;padding:22px 25px;overflow:auto}
.logo{display:flex;align-items:center;gap:12px}
.logo i{width:50px;height:50px;border-radius:50%;background:var(--sand);display:grid;place-items:center;font-style:normal}
.logo svg{width:24px;height:24px;stroke:var(--side);fill:none;stroke-width:1.6}
.logo b{font:600 30px "Fraunces",serif;display:block;line-height:1}.logo small{font-size:11px;letter-spacing:.2em;text-transform:uppercase;opacity:.8}
.cap{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:#aebdb2;margin:30px 0 12px 14px}
.nv{display:flex;align-items:center;gap:14px;width:100%;padding:15px 16px;border-radius:99px;color:#dfe8e1;font-size:17px;text-align:left;margin-bottom:5px}
.nv.on{background:#3b5f4e;color:#fff;font-weight:700}.nv.on:after{content:"";margin-left:auto;width:7px;height:7px;border-radius:50%;background:var(--sand)}
.nv svg,.bn svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}
.promo{margin:26px 0;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);border-radius:22px;padding:20px}
.promo h3{font-size:22px;margin-bottom:8px}.promo p{font-size:14px;opacity:.8;margin:0 0 14px}.promo button{color:var(--sand);font-weight:700;font-size:14px}
.me{margin-top:auto;display:flex;align-items:center;gap:12px;padding:10px 4px;text-align:left;width:100%}
.av{width:44px;height:44px;border-radius:50%;background:#4a6a56;display:grid;place-items:center;font-weight:700;color:var(--sand);flex:none;text-transform:uppercase}
.me small{display:block;opacity:.7;font-size:13px}
.tw{display:flex;gap:10px;font-size:14px;opacity:.85;padding:10px 4px;align-items:center}
.main{padding:20px 18px 110px;max-width:1240px;margin:0 auto}
.mtop{display:flex;justify-content:space-between;align-items:center;padding:4px 0 16px;margin-bottom:12px;border-bottom:1px solid var(--line)}
.mtop .logo i{width:42px;height:42px}.mtop .logo b{font-size:26px}.mtop small{display:none}
.mb{width:44px;height:44px;border:1.5px solid var(--line);border-radius:50%;font-size:20px}
.bnav{position:fixed;left:0;right:0;bottom:0;background:var(--bg);border-top:1px solid var(--line);display:flex;padding-bottom:env(safe-area-inset-bottom,0px);z-index:5}
.bn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 0 8px;font-size:12px;color:var(--mut)}.bn.on{color:var(--forest);font-weight:700}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .bn.on{color:var(--sand)}}
@media (min-width:900px){.side{display:flex}.main{margin-left:310px;max-width:none;padding:38px 56px 60px}.mtop,.bnav{display:none}}
.eb{font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:var(--mut);margin-bottom:10px}
.pg h1{font-size:clamp(38px,6vw,60px);margin-bottom:10px}.pg>p{color:var(--mut);margin:0 0 24px}
.hero{background:var(--forest);color:#f7f5f0;border-radius:30px;padding:30px 24px;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;right:-90px;top:-80px;width:340px;height:340px;border:1px solid rgba(255,255,255,.12);border-radius:50%}
.hero .eb{color:var(--sand);display:flex;align-items:center;gap:12px}.hero .eb i{width:34px;height:1.5px;background:var(--sand)}
.hero h1{font-size:clamp(44px,8vw,88px);margin:6px 0 20px}.hero em{color:var(--sand)}
.hero p{max-width:46ch;opacity:.85;margin:0 0 24px}.row{display:flex;gap:12px;flex-wrap:wrap;position:relative}
.badge{display:none;position:absolute;right:30px;bottom:26px;transform:rotate(-4deg);background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.2);border-radius:22px;padding:18px 24px}
.badge b{font:500 40px "Fraunces",serif}.badge small{font-size:18px}.badge span{display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
@media (min-width:900px){.badge{display:block}.hero{padding:70px 70px 60px}}
.sh{display:flex;justify-content:space-between;align-items:end;margin:40px 0 18px}.sh h2{font-size:clamp(30px,4vw,44px)}.sh button{font-weight:700;color:var(--ink)}
.grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}
.gc{background:var(--card);border:1px solid var(--line);border-radius:26px;overflow:hidden;cursor:pointer;text-align:left}
.art{position:relative;height:250px;display:grid;place-items:center;background:linear-gradient(160deg,#d9e1cf,#b9ccbd)}
.art.shirt{background:linear-gradient(160deg,#eadfcc,#dcc7a8)}.art.jeans{background:linear-gradient(160deg,#cfdcd4,#b9cbc8)}.art.kurta{background:linear-gradient(160deg,#ead7c8,#d9bba8)}.art.scarf{background:linear-gradient(160deg,#dde0cc,#cdd1b6)}
.art svg{width:78%;height:78%}.art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.chip{position:absolute;left:16px;top:16px;background:#e3e8dc;color:#34503f;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;padding:7px 13px;border-radius:99px}
.chip.repaired{background:#f6e5b8;color:#7a4b12}.chip.collection{background:#dfe6e0}
.gb{padding:20px 22px}.gt{display:flex;justify-content:space-between}.gt h3{font-size:23px}.gb p{margin:6px 0 14px;color:var(--mut);font-size:14.5px}.gb hr{border:0;border-top:1px solid var(--line);margin:0 0 12px}.gb small{color:var(--mut)}.gb small b{color:var(--ink);font-weight:500}
.two{display:grid;gap:20px;margin-top:24px}@media (min-width:900px){.two{grid-template-columns:2fr 1fr}}
.pn{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:28px}.pn h2{font-size:clamp(30px,4vw,42px);margin:8px 0 18px}
.big{font:500 64px "Fraunces",serif;line-height:1}.big small{font:400 17px "DM Sans";color:var(--mut)}
.wr{width:56px;height:56px;border-radius:50%;background:var(--forest);display:grid;place-items:center;color:#fff;font-size:24px;margin-bottom:14px}
.fld{width:100%;padding:15px 20px;border-radius:99px;border:1.5px solid var(--line);background:var(--inp);color:var(--ink);font:inherit}
.srch{max-width:480px;margin-bottom:24px}
label{display:block;font-weight:700;margin:16px 0 8px}
.scan{display:grid;border:1px solid var(--line);border-radius:28px;overflow:hidden;background:var(--card);max-width:960px}@media (min-width:760px){.scan{grid-template-columns:1fr 1.3fr}}
.sl{background:var(--forest);color:#f7f5f0;padding:34px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px}
.dz{border:2px dashed rgba(255,255,255,.4);border-radius:30px;padding:26px}.dz i{display:grid;place-items:center;width:110px;height:110px;border-radius:26px;background:var(--sand);font-size:40px;font-style:normal}
.sr{padding:30px 28px}.sr h2{font-size:34px;margin:6px 0 8px}.sr p{color:var(--mut);margin:0}
.lnk{text-decoration:underline;color:var(--mut)}.err{color:#b4372b;min-height:22px;margin:10px 0 0;font-size:14px}
.fl{display:grid;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:18px;margin-bottom:24px}@media (min-width:760px){.fl{grid-template-columns:2fr 1fr 1fr}}
.fl label{margin:0 0 6px;font-size:14px}.fl select{width:100%;padding:14px;border-radius:99px;border:1.5px solid var(--line);background:var(--inp);color:var(--ink);font:inherit}
.lc .art{height:210px;background:linear-gradient(160deg,#d3e0d0,#b3c9b8)}.lc .art.up{background:linear-gradient(160deg,#e6d4c3,#dcbfa9)}
.lc .art svg{width:62%;height:75%}.lc .chip{top:auto;bottom:14px;background:#fdfcf9;color:var(--ink)}
.lc small{letter-spacing:.1em;text-transform:uppercase;font-weight:700;font-size:12px}
.stats{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-top:20px}
.st{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:20px}.st .eb{font-size:11px}.st b{font:500 42px "Fraunces",serif;display:block}.st span{color:var(--mut);font-size:14px}
.ih{background:var(--forest);color:#f7f5f0;border-radius:28px;padding:34px}.ih .eb{color:var(--sand)}.ih .big{font-size:clamp(72px,12vw,130px)}.ih .big small{color:var(--sand);font-size:32px}
.bar{height:9px;border-radius:9px;background:rgba(255,255,255,.18);margin:26px 0 10px;overflow:hidden}.bar i{display:block;height:100%;background:var(--sand);border-radius:9px}
.br{margin:20px 0}.br div:first-child{display:flex;justify-content:space-between}.br .tr{height:9px;border-radius:9px;background:var(--line);margin-top:8px;overflow:hidden}.br i{display:block;height:100%;border-radius:9px}
.pf{display:grid;gap:12px 20px;grid-template-columns:1fr}@media (min-width:600px){.pf{grid-template-columns:1fr 1fr}.pf .w{grid-column:1/-1}}
.pf .fld{border-radius:99px}.pf label{margin:6px 0}
.nt{padding:16px 0;border-top:1px solid var(--line);display:flex;gap:12px;cursor:pointer}.nt:first-of-type{border-top:0}
.nt i{width:9px;height:9px;border-radius:50%;background:var(--line);margin-top:9px;flex:none}.nt.un i{background:var(--forest)}
.nt b{display:block;font-weight:500;font-size:17px}.nt p{margin:3px 0;color:var(--mut);font-size:14.5px}.nt small{color:var(--mut)}
.nt em{margin-left:auto;font-style:normal;font-size:13px;font-weight:700;color:var(--mut)}
.tag{background:#ece5d6;color:var(--ink);padding:6px 14px;border-radius:99px;font-size:13px;font-weight:700}
.rd{display:inline-flex;align-items:center;gap:8px;margin:6px 20px 6px 0;font-weight:500}.rd input{width:20px;height:20px;accent-color:var(--forest)}
.ov{position:fixed;inset:0;background:rgba(15,28,21,.6);display:none;align-items:center;justify-content:center;padding:18px;z-index:30}.ov.on{display:flex}
.mdl{background:var(--bg);border-radius:28px;padding:26px;max-width:540px;width:100%;max-height:90vh;overflow:auto;position:relative}
.mdl h2{font-size:30px;margin-bottom:6px}.mdl .x{position:absolute;right:16px;top:14px;width:38px;height:38px;font-size:18px;border-radius:50%;border:1.5px solid var(--line)}
.mdl img.pv{width:100%;max-height:260px;object-fit:cover;border-radius:18px;margin:10px 0}
.mdl ol{padding-left:20px;margin:14px 0}.mdl li{margin:8px 0}.mdl .row{margin-top:18px}.mdl .btn{padding:12px 18px;font-size:15px}
.ath{position:fixed;inset:0;z-index:40;background:linear-gradient(160deg,#2e5042,#16301f);display:flex;padding:20px;overflow-y:auto;-webkit-overflow-scrolling:touch}
.ath[hidden],[hidden]{display:none!important}
.ath .box{background:var(--bg);border-radius:28px;padding:28px 24px;width:100%;max-width:400px;margin:auto}
.ath h1{font-size:34px;margin:16px 0 4px}.ath .logo i{background:var(--forest)}.ath .logo svg{stroke:var(--sand)}.ath .logo small{display:none}
.tst{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:12px 22px;border-radius:99px;font-weight:700;font-size:14px;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50}.tst.on{opacity:1}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
